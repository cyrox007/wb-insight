# Environment
APP_ENV=development
DEBUG=True

# Server
SERVER_HTTP_PROTOCOL=http://
SERVER_ADDR=localhost
SERVER_PORT=9000

# CORS allowed origins, comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wb
DB_USER=postgres
DB_PASSWORD=change-me

# Required security configuration
API_TOKEN_ENCRYPTION_KEY=replace-with-generated-key
JWT_SECRET_KEY=replace-with-random-key
# Recommended independent HMAC key for legal-consent IP/User-Agent evidence.
# If omitted, JWT_SECRET_KEY is used as a compatibility fallback.
# LEGAL_EVIDENCE_HMAC_KEY=replace-with-independent-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh_token
# COOKIE_DOMAIN=.example.com

# Account lifecycle / password recovery. Disabled by default until SMTP is set.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_FROM_EMAIL=no-reply@localhost
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Soft-deactivated accounts are retained for this technical period unless the
# approved legal/retention policy defines another value. No automatic hard purge.
ACCOUNT_DEACTIVATION_RETENTION_DAYS=90

# Development-only fake billing. Keep false unless explicitly testing payments locally.
# It is ignored when APP_ENV=production.
ALLOW_FAKE_BILLING=false

# Sber internet acquiring. Disabled until merchant credentials are configured.
# Development default URL is the official sandbox. Production must explicitly
# provide the production gateway URL; startup rejects ecomift in production.
SBER_ACQUIRING_ENABLED=false
SBER_API_BASE_URL=https://ecomift.sberbank.ru/ecomm/gw/partner/api/v1
# SBER_USERNAME=
# SBER_PASSWORD=
# Public frontend pages to which the gateway sends the customer after payment.
# Backend appends payment_id and result query parameters per payment attempt.
# SBER_RETURN_URL=https://app.example.com/billing/success
# SBER_FAIL_URL=https://app.example.com/billing/success
SBER_CURRENCY_CODE=643
SBER_HTTP_TIMEOUT_SECONDS=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Wildberries partner-service identity. BOTH values are required in production.
# They can be issued by WB API before Catalog publication via
# business-solutions@rwb.ru. Every seller-data request using Base or Service
# token is signed with X-Client-Secret.
# WB_SERVICE_ID=
# WB_SERVICE_SECRET=

# Wildberries HTTP transport. Redis coordinates requests per marketplace
# credential + logical endpoint. Endpoint-specific defaults reflect the current
# documented WB account limits for the sync endpoints used by this project.
WB_API_MIN_INTERVAL_SECONDS=1.0
WB_FINANCE_MIN_INTERVAL_SECONDS=60.0
WB_STOCKS_MIN_INTERVAL_SECONDS=20.0
WB_CONTENT_CARDS_MIN_INTERVAL_SECONDS=0.6
WB_PRICES_MIN_INTERVAL_SECONDS=0.6
WB_OPERATIONAL_MIN_INTERVAL_SECONDS=60.0
WB_ADVERT_CAMPAIGNS_MIN_INTERVAL_SECONDS=0.2
WB_ADVERT_STATS_MIN_INTERVAL_SECONDS=20.0
WB_ADVERT_LOOKBACK_DAYS=31
WB_FUNNEL_MIN_INTERVAL_SECONDS=20.0
WB_FUNNEL_LOOKBACK_DAYS=7
WB_FUNNEL_NM_BATCH_SIZE=20
WB_STORAGE_CREATE_MIN_INTERVAL_SECONDS=60.0
WB_STORAGE_STATUS_MIN_INTERVAL_SECONDS=5.0
WB_STORAGE_DOWNLOAD_MIN_INTERVAL_SECONDS=60.0
WB_STORAGE_BACKFILL_DAYS=30
WB_STORAGE_REFRESH_DAYS=8
WB_STORAGE_STATUS_MAX_POLLS=36
WB_API_MAX_ATTEMPTS=4
WB_API_BACKOFF_BASE_SECONDS=1.0
WB_API_MAX_BACKOFF_SECONDS=60.0

# Durable sync execution. Lease is longer than Celery's 30-minute hard limit;
# expired processing jobs are requeued automatically unless retry budget ended.
SYNC_JOB_LEASE_SECONDS=2100
SYNC_JOB_MAX_ATTEMPTS=3
SYNC_JOB_RETRY_BASE_SECONDS=60
SYNC_JOB_RETRY_MAX_SECONDS=900

# Operations monitoring. HTTP counters are intentionally off in development.
OPS_SYNC_STALE_MINUTES=180
OPS_FAILED_JOB_LOOKBACK_MINUTES=60
OPS_CREDENTIAL_EXPIRY_WARNING_DAYS=14
OPS_WB_SERVICE_SECRET_EXPIRY_WARNING_DAYS=30
# ISO-8601 rotation deadline for the WB partner service secret, including timezone.
# OPS_WB_SERVICE_SECRET_EXPIRES_AT=2026-12-01T00:00:00+03:00
OPS_HTTP_METRICS_ENABLED=false
OPS_HTTP_ERROR_WINDOW_MINUTES=5
OPS_HTTP_5XX_RATE_THRESHOLD=0.05
OPS_HTTP_MIN_REQUESTS=20
OPS_ALERT_CHECK_INTERVAL_SECONDS=900
OPS_ALERT_REPEAT_SECONDS=3600
# Optional HTTPS webhook receiving aggregate operational snapshots only.
# OPS_ALERT_WEBHOOK_URL=https://monitoring.example.com/hooks/wb-insight
OPS_ALERT_WEBHOOK_TIMEOUT_SECONDS=5