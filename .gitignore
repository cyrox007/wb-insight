.env
.env.*
!.env.production.example
*.pyc
__pycache__/
.DS_Store

# Артефакты virtualenv, создаваемые обновлением и откатом.
# Без завершающего слеша: часть артефактов может быть символическими ссылками.
backend/venv.broken.*
backend/venv.previous.*
backend/venv.release.*
backend/venv.releases

# Локальные архивы журналов не должны попадать в Git.
/log-archive/
/.artifacts/log-archive/
