# Copy to .env.production on the deployment host. Never commit real secrets.

APP_ENV=production
DEBUG=false

SERVER_HTTP_PROTOCOL=https://
SERVER_ADDR=app.example.com
SERVER_PORT=443
ALLOWED_ORIGINS=https://app.example.com

DB_NAME=wb
DB_USER=wbinsight
DB_PASSWORD=replace-with-strong-db-password

API_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-compatible-key
JWT_SECRET_KEY=replace-with-long-random-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh_token
# COOKIE_DOMAIN=.example.com

ALLOW_FAKE_BILLING=false

# Wildberries partner credentials are mandatory in production.
WB_SERVICE_ID=replace-with-wb-service-id
WB_SERVICE_SECRET=replace-with-wb-service-secret
# Rotation/expiry deadline supplied by WB or your secret-management policy.
# Must include timezone. Used only for alerts; the secret value is never emitted.
OPS_WB_SERVICE_SECRET_EXPIRES_AT=2026-12-01T00:00:00+03:00
OPS_WB_SERVICE_SECRET_EXPIRY_WARNING_DAYS=30

# Sber acquiring: keep disabled until merchant production credentials and URLs are ready.
SBER_ACQUIRING_ENABLED=false
SBER_API_BASE_URL=https://replace-with-production-sber-gateway
SBER_USERNAME=replace-with-merchant-username
SBER_PASSWORD=replace-with-merchant-password
SBER_RETURN_URL=https://app.example.com/billing/success
SBER_FAIL_URL=https://app.example.com/billing/success
SBER_CURRENCY_CODE=643
SBER_HTTP_TIMEOUT_SECONDS=10

PUBLIC_HTTP_PORT=8080

WB_API_MIN_INTERVAL_SECONDS=1.0
WB_FINANCE_MIN_INTERVAL_SECONDS=60.0
WB_STOCKS_MIN_INTERVAL_SECONDS=20.0
WB_CONTENT_CARDS_MIN_INTERVAL_SECONDS=0.6
WB_PRICES_MIN_INTERVAL_SECONDS=0.6
WB_OPERATIONAL_MIN_INTERVAL_SECONDS=60.0
WB_ADVERT_CAMPAIGNS_MIN_INTERVAL_SECONDS=0.2
WB_ADVERT_STATS_MIN_INTERVAL_SECONDS=20.0
WB_ADVERT_LOOKBACK_DAYS=31
WB_FUNNEL_MIN_INTERVAL_SECONDS=20.0
WB_FUNNEL_LOOKBACK_DAYS=7
WB_FUNNEL_NM_BATCH_SIZE=20
WB_STORAGE_CREATE_MIN_INTERVAL_SECONDS=60.0
WB_STORAGE_STATUS_MIN_INTERVAL_SECONDS=5.0
WB_STORAGE_DOWNLOAD_MIN_INTERVAL_SECONDS=60.0
WB_STORAGE_BACKFILL_DAYS=30
WB_STORAGE_REFRESH_DAYS=8
WB_STORAGE_STATUS_MAX_POLLS=36
WB_API_MAX_ATTEMPTS=4
WB_API_BACKOFF_BASE_SECONDS=1.0
WB_API_MAX_BACKOFF_SECONDS=60.0

SYNC_JOB_LEASE_SECONDS=2100
SYNC_JOB_MAX_ATTEMPTS=3
SYNC_JOB_RETRY_BASE_SECONDS=60
SYNC_JOB_RETRY_MAX_SECONDS=900

# Operations monitoring / alerting.
OPS_SYNC_STALE_MINUTES=180
OPS_FAILED_JOB_LOOKBACK_MINUTES=60
OPS_CREDENTIAL_EXPIRY_WARNING_DAYS=14
OPS_HTTP_METRICS_ENABLED=true
OPS_HTTP_ERROR_WINDOW_MINUTES=5
OPS_HTTP_5XX_RATE_THRESHOLD=0.05
OPS_HTTP_MIN_REQUESTS=20
OPS_ALERT_CHECK_INTERVAL_SECONDS=900
OPS_ALERT_REPEAT_SECONDS=3600
# Optional HTTPS endpoint owned by your monitoring stack.
# OPS_ALERT_WEBHOOK_URL=https://monitoring.example.com/hooks/wb-insight
OPS_ALERT_WEBHOOK_TIMEOUT_SECONDS=5

# PostgreSQL backup scripts in ops/ read these only on the backup host/job.
# Keep the passphrase file outside the repository and outside the backup directory.
BACKUP_DIR=/var/backups/wb-insight
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/run/secrets/wb-insight-backup-passphrase
